# Crunchyroll Messages

msgctxt "#30060"
msgid "Login failed"
msgstr "Login gagal"

msgctxt "#30061"
msgid "An error occurred"
msgstr "Terjadi kesalahan"

msgctxt "#30062"
msgid "You need to be logged in"
msgstr "Anda harus masuk terlebih dahulu"

msgctxt "#30063"
msgid "You need to be a premium member"
msgstr "Anda harus menjadi anggota premium"

msgctxt "#30064"
msgid "Failed to play video"
msgstr "Gagal memutar video"

msgctxt "#30065"
msgid "Do you want to continue watching at %s%%?"
msgstr "Apakah Anda ingin melanjutkan menonton di %s%%?"

msgctxt "#30066"
msgid "If the video does not start wait 30 seconds for the fallback to start."
msgstr "Jika video tidak mulai, tunggu 30 detik untuk memulai cadangan."

msgctxt "#30067"
msgid "Add to queue"
msgstr "Tambah ke antrean"

msgctxt "#30068"
msgid "Remove from queue"
msgstr "Hapus dari antrean"

msgctxt "#30069"
msgid "Alternative Subtitle Language"
msgstr "Bahasa Takarir Alternatif"

msgctxt "#30070"
msgid "None"
msgstr "Tidak ada"

msgctxt "#30071"
msgid "Added to queue"
msgstr "Ditambahkan ke antrean"

msgctxt "#30072"
msgid "[COLOR orange]%s[/COLOR] (change profile)"
msgstr "[COLOR orange]%s[/COLOR] (ubah profil)"

msgctxt "#30073"
msgid "Choose your profile"
msgstr "Pilih profil Anda"

msgctxt "#30080"
msgid "There are too many active streams. Please try again later."
msgstr "Terlalu banyak pemutaran aktif. Silakan coba lagi nanti."

msgctxt "#30090"
msgid "No search results"
msgstr "Tidak ada hasil pencarian"

# Developer Options

msgctxt "#30101"
msgid "Debug Logging"
msgstr "Pencatatan Debug"

msgctxt "#30102"
msgid "Enable detailed logging for troubleshooting. Only enable when requested by support."
msgstr "Aktifkan pencatatan detail untuk pemecahan masalah. Hanya aktifkan jika diminta oleh tim dukungan."

msgctxt "#30240"
msgid "Developer Options"
msgstr "Opsi Pengembang"

msgctxt "#30241"
msgid "Device ID"
msgstr "ID Perangkat"

msgctxt "#30242"
msgid "Reset Authentication"
msgstr "Atur Ulang Autentikasi"

msgctxt "#30243"
msgid "Deletes all stored session data. You will need to authenticate again."
msgstr "Menghapus semua data sesi yang tersimpan. Anda harus melakukan autentikasi ulang."

msgctxt "#30244"
msgid "Session data deleted successfully. Please restart the addon to authenticate again."
msgstr "Data sesi berhasil dihapus. Silakan restart addon untuk melakukan autentikasi ulang."

# Device Authentication Dialog

msgctxt "#30300"
msgid "Visit: %s"
msgstr "Kunjungi: %s"

msgctxt "#30301"
msgid "Waiting for activation..."
msgstr "Menunggu aktivasi..."

msgctxt "#30302"
msgid "Time remaining: %02d:%02d"
msgstr "Waktu tersisa: %02d:%02d"

msgctxt "#30303"
msgid "New code generated - please visit the URL again"
msgstr "Kode baru dibuat - silakan kunjungi URL kembali"

msgctxt "#30304"
msgid "Authentication successful!"
msgstr "Autentikasi berhasil!"

msgctxt "#30305"
msgid "! Code expired - click Refresh for new code"
msgstr "! Kode kedaluwarsa - klik Segarkan untuk kode baru"

msgctxt "#30306"
msgid "x Error: %s"
msgstr "x Kesalahan: %s"

msgctxt "#30307"
msgid "Failed to generate new code"
msgstr "Gagal membuat kode baru"

msgctxt "#30308"
msgid "Failed to refresh code"
msgstr "Gagal menyegarkan kode"

# User-friendly Error Messages

msgctxt "#30400"
msgid "Unable to connect to Crunchyroll. Please check your internet connection and try again."
msgstr "Tidak dapat terhubung ke Crunchyroll. Silakan periksa koneksi internet Anda dan coba lagi."

msgctxt "#30401"
msgid "Your login session has expired. Please authenticate again."
msgstr "Sesi login Anda telah kedaluwarsa. Silakan lakukan autentikasi ulang."

msgctxt "#30402"
msgid "Crunchyroll servers are currently unavailable. Please try again later."
msgstr "Server Crunchyroll saat ini tidak tersedia. Silakan coba lagi nanti."

msgctxt "#30403"
msgid "Device authentication was cancelled. Please try again if you want to continue."
msgstr "Autentikasi perangkat dibatalkan. Silakan coba lagi jika Anda ingin melanjutkan."

msgctxt "#30404"
msgid "Device code has expired. Please start authentication again."
msgstr "Kode perangkat telah kedaluwarsa. Silakan mulai autentikasi kembali."

msgctxt "#30405"
msgid "Authentication failed. Please restart the addon and try again."
msgstr "Autentikasi gagal. Silakan restart addon dan coba lagi."

# Device Activation Dialog UI

msgctxt "#30309"
msgid "Crunchyroll Device Activation"
msgstr "Aktivasi Perangkat Crunchyroll"

msgctxt "#30310"
msgid "Enter the activation code shown below:"
msgstr "Masukkan kode aktivasi yang ditunjukkan di bawah ini:"

msgctxt "#30311"
msgid "Refresh Code"
msgstr "Segarkan Kode"

msgctxt "#30312"
msgid "Cancel"
msgstr "Batal"

msgctxt "#30313"
msgid "- OR SCAN QR CODE -"
msgstr "- ATAU PINDAI KODE QR -"


msgctxt "#30314"
msgid "Fill subtitle gaps"
msgstr "Isi celah takarir"

msgctxt "#30315"
msgid "Fills distracting gaps between subtitle lines (0-6 frames) to improve readability"
msgstr "Isi jeda kosong yang mengganggu di antara baris takarir (0-6 frame) untuk meningkatkan kenyamanan membaca"
